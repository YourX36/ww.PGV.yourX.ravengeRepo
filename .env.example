# Public hostname configured for the Cloudflare Tunnel.
REPOSITORY_HOST=repo.gpodvorotov.ru

# Cloudflare Zero Trust -> Networks -> Connectors -> Cloudflare Tunnels.
# Keep the real token secret and never commit the .env file.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# Official revenge-bundle-next branch, tag or full commit SHA.
REVENGE_NEXT_REF=main
